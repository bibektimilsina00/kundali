# ---- LLM (AgentRouter) --------------------------------------------------
# AgentRouter is Anthropic-wire-compatible: same SDK, same model IDs,
# only the base URL changes. Unset LLM_BASE_URL to hit Anthropic directly.
LLM_BASE_URL=https://agentrouter.org/v1
LLM_API_KEY=sk-...
LLM_MODEL=claude-opus-5
LLM_MODEL_CHEAP=claude-haiku-4-5

# ---- infra --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://kundali:kundali@localhost:5432/kundali
REDIS_URL=redis://localhost:6379/0

# ---- auth ---------------------------------------------------------------
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=43200

# ---- astrology ----------------------------------------------------------
# Swiss Ephemeris data files. Download separately; do not commit.
EPHEMERIS_PATH=./ephe
