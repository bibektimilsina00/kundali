  "info": {
    "description": "\nOne backend, two clients (web and Flutter).\n\n**Compatibility:** additive changes only within `/v1` \u2014 no removed or renamed\nfields, no newly-required request fields, no narrowed types. App Store users\nstay on old builds for months. Clients must treat unknown enum values as\n\"other\". See docs/architecture.md \u00a77.\n\n**Errors** are always `{\"error\": {\"code\", \"message\", \"details\"}}`. Switch on\n`code`; never parse `message`.\n",
    "title": "Kundali API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "meta"
        ]
      }
    },
    "/v1/kundali": {
      "post": {
        "description": "Computes a full Vedic chart from birth details: Lahiri ayanamsa, whole-sign houses, mean nodes, Vimshottari dasha. Deterministic and synchronous \u2014 the calculation is local arithmetic against an ephemeris, not a job.\n\nSee docs/astrology-methodology.md for every methodology decision.",
        "operationId": "create_kundali_v1_kundali_post",
        "parameters": [
          {
            "description": "Dasha levels to return: 1 maha, 2 +antar, 3 +pratyantar. Defaults to 2 \u2014 the full tree is 819 periods and ~78KB, against ~12KB for two levels. Request 3 only when drilling into a specific period.",
            "in": "query",
            "name": "dasha_depth",
            "required": false,
            "schema": {
              "default": 2,
              "description": "Dasha levels to return: 1 maha, 2 +antar, 3 +pratyantar. Defaults to 2 \u2014 the full tree is 819 periods and ~78KB, against ~12KB for two levels. Request 3 only when drilling into a specific period.",
              "maximum": 3,
              "minimum": 1,
              "title": "Dasha Depth",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BirthDetailsIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChartOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Generate a birth chart",
        "tags": [
          "kundali"
        ]
      }
    },
    "/v1/places": {
      "get": {
        "description": "Prefix search over 786,650 populated places. Every populated place in Nepal and India, plus everywhere worldwide with population >= 1000.\n\nAlternate names are searched too \u2014 GeoNames records Lumbini under the primary name 'Rummin-dei', so searching primary names alone would make it unfindable.\n\nEach result carries an **IANA zone name**, resolved here rather than guessed by the client.",
        "operationId": "search_v1_places_get",
        "parameters": [
          {
            "description": "Place name",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "description": "Place name",
              "maxLength": 80,
              "minLength": 2,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 50,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaceSearchOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search birthplaces",
        "tags": [
          "places"
        ]
      }
    }
  }
}
